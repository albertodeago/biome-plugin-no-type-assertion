language js

// Match TypeScript `as` type assertions only.
// `$expr as $type` matches the `as` token in any AST construct, including
// import aliases (`import { foo as bar }`, `import * as ns`) and the alias
// inside `JsNamedImportSpecifier`. Constraining the captured node to
// `TsAsExpression()` filters those out so only real type assertions remain.
`$expr as $type` as $node where {
    $node <: TsAsExpression(),
    ! $type <: "const",
    register_diagnostic(span=$node, message="Avoid type assertions. Use type guards or proper typing instead.", severity="error")
}
