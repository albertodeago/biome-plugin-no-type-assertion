language js

// Match 'as' type assertions
`$expr as $type` where {
	// Exclude 'as const' and import aliases
	! $type <: "const",
	// Exclude import aliases by checking we're not inside an import statement
	! $expr <: within `import $_ from $_` ,
	register_diagnostic(span=$expr, message="Avoid type assertions. Use type guards or proper typing instead.", severity="error")
}
